PORT=3002
HOST=127.0.0.1
DATA_DIR=./data
APP_ORIGIN=http://localhost:5174,http://127.0.0.1:5174
# Use 1 only behind a trusted single-hop reverse proxy with no direct bypass.
TRUST_PROXY=0
# Set an exact HTTPS origin before enabling live mail or billing.
PUBLIC_APP_URL=http://localhost:5174

# Empty comma-separated workspace-ID allowlists enable no workspace.
OPENAI_API_KEY=
OPENAI_WORKSPACE_IDS=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional RoboApply-compatible text gateway. Keep the configured model exact.
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_BASE_URL is also supported and takes precedence.
# LLM_MODEL=
# LLM_INTERVIEW_MODEL=
# LLM_INTERVIEW_REASONING_EFFORT=
# Optional reasoning effort: none|minimal|low|medium|high|xhigh|max|provider.
# Task-specific values override the general setting. "provider" omits the field.
# Job drafts default to low only for recognized OpenAI reasoning model families;
# unknown/non-reasoning models retain their provider defaults.
# LLM_REASONING_EFFORT=
# LLM_JOB_REASONING_EFFORT=
# LLM_WORKSPACE_IDS=
# Voice transcription is separate from the text gateway. Optional explicit HTTPS API base:
# OPENAI_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1

# Professional enrichment requires explicit per-candidate consent and selected-field approval.
PDL_API_KEY=
ENRICHMENT_WORKSPACE_IDS=
# Separate allowlist for paid People Data Labs candidate search. Each pack requires confirmation.
SOURCING_WORKSPACE_IDS=

# Slack app: commands, chat:write, im:write scopes. Generate/back up a stable 64-hex key.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_APP_ID=
SLACK_ENCRYPTION_KEY=
SLACK_APP_ORIGIN=http://localhost:5174
SLACK_WORKSPACE_IDS=
SLACK_TEAM_IDS=

# Calendar OAuth. Generate and securely back up a stable 64-hex-character key.
CALENDAR_TOKEN_ENCRYPTION_KEY=
CALENDAR_APP_ORIGIN=http://localhost:5174
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# Greenhouse Harvest v3 read-only imports and explicit Recall capture.
PROVIDER_WORKSPACE_IDS=
GREENHOUSE_CLIENT_ID=
GREENHOUSE_CLIENT_SECRET=
# Optional numeric Greenhouse user ID for provider access scoping.
GREENHOUSE_USER_ID=
RECALL_API_KEY=
RECALL_REGION=us-east-1

# Outbox never delivers. Live mail requires Resend, a verified sender,
# HTTPS PUBLIC_APP_URL, and explicit workspace IDs.
MAIL_MODE=outbox
RESEND_API_KEY=
MAIL_FROM=
# Existing RoboApply aliases: ROBOAPPLY_EMAIL_FROM, APP_URL (used only when canonical keys are empty).
MAIL_REPLY_TO=
MAIL_WORKSPACE_IDS=
# Stable random secret, at least 32 characters, required for live screening mail.
# Outbox mode creates a local key in DATA_DIR when this is empty.
SCREENING_OUTREACH_SECRET=

# Use your own recurring seat prices and Stripe test mode first.
BILLING_WORKSPACE_IDS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=

# Optional live screening: requires the separate agents/interview service.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
INTERVIEW_ENGINE_AGENT_NAME=arkoffer-interviewer
# Stable random signing secret of at least 24 characters; same value on API and agent.
LIVEKIT_AGENT_CALLBACK_SECRET=
# Exact agent-reachable URL, including /api/live-interviews/callback.
INTERVIEW_AGENT_CALLBACK_URL=
# If omitted, existing LLM_WORKSPACE_IDS / OPENAI_WORKSPACE_IDS is used.
# An explicitly empty override enables no workspace.
# LIVEKIT_WORKSPACE_IDS=
# LiveKit Cloud defaults to its speech inference; self-hosted LiveKit needs OpenAI speech.
# INTERVIEW_VOICE_PROVIDER=livekit
# INTERVIEW_STT_MODEL=auto
# INTERVIEW_TTS_MODEL=
# INTERVIEW_TTS_VOICE=
# OPENAI_TTS_BASE_URL=https://api.openai.com/v1

# Optional consented LiveKit interview MP4 archive. Use a PRIVATE bucket with
# public access blocked, encryption enabled, and lifecycle expiry as a backstop.
# LiveKit Egress must be installed/enabled and able to reach this bucket.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional S3-compatible HTTPS endpoint; omit for AWS S3.
S3_ENDPOINT=
# Retention is saved per screening (1–90 days, default 30), not an env override.
